# =============================================================================
# Ivonne & Rosa — Variables de entorno
# Copia este archivo a .env (pnpm db:setup lo hace automáticamente si no existe).
# NUNCA subas secretos reales al repositorio.
# =============================================================================

# --- App -----------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Ivonne & Rosa"
# Zona horaria de negocio
APP_TIMEZONE=America/Mexico_City

# --- Base de datos ---------------------------------------------------------------
DATABASE_URL=postgresql://ivonne:ivonne_dev_pw@localhost:5432/ivonne_rosa?schema=public
# Base separada para pruebas de integración / E2E
TEST_DATABASE_URL=postgresql://ivonne:ivonne_dev_pw@localhost:5432/ivonne_rosa_test?schema=public
# Base para pruebas E2E (Playwright); se re-siembra en cada corrida
E2E_DATABASE_URL=postgresql://ivonne:ivonne_dev_pw@localhost:5432/ivonne_rosa_e2e?schema=public

# --- Auth.js ---------------------------------------------------------------------
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=dev-only-change-me-dev-only-change-me-123456
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# --- Almacenamiento (S3 compatible: AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO, RustFS) ---
# STORAGE_DRIVER=s3 | local  (local sólo para desarrollo; NO usar en Docker/producción)
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ivonne-rosa
STORAGE_ACCESS_KEY=irdevaccess
STORAGE_SECRET_KEY=irdevsecret123
STORAGE_FORCE_PATH_STYLE=true
# URL pública opcional (CDN) para assets públicos; si se omite se usan URLs firmadas
STORAGE_PUBLIC_URL=
UPLOAD_MAX_MB=8

# --- Pagos -----------------------------------------------------------------------
# PAYMENT_PROVIDER=mock | stripe | mercadopago
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me

# --- Email -----------------------------------------------------------------------
# EMAIL_PROVIDER=mock | resend
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM="Ivonne & Rosa <hola@example.com>"

# --- WhatsApp --------------------------------------------------------------------
# WHATSAPP_PROVIDER=mock | cloud_api
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número público del negocio (formato internacional sin +), usado en deep links wa.me
WHATSAPP_BUSINESS_NUMBER=5215512345678

# --- IA --------------------------------------------------------------------------
# AI_PROVIDER=mock | anthropic | openai
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# --- Feature flags ---------------------------------------------------------------
AI_DESIGNER_ENABLED=true
PAYMENTS_ENABLED=true
WHATSAPP_ENABLED=true
MEMORY_CAPSULE_ENABLED=true

# --- Jobs / cron -----------------------------------------------------------------
# Token para invocar /api/cron/notifications desde el scheduler de Dokploy
CRON_SECRET=dev-cron-secret-change-me

# --- Observabilidad (opcional) ---------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# (Opcional) Firefox de Playwright en otra ruta si no arranca desde %LOCALAPPDATA% (Windows)
# E2E_FIREFOX_EXECUTABLE=D:/ruta/firefox-1543/firefox/firefox.exe
